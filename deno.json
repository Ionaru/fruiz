{
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "fix": "deno fmt . && deno lint --fix .",
    "test": "deno test -A tests/",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "db:sync": "deno x drizzle-kit push",
    "playback-gain:backfill": "deno run -A tools/playback_gain_backfill.ts",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "include": [
        "no-non-null-assertion",
        "eqeqeq",
        "no-process-global",
        "no-node-globals"
      ],
      "tags": [
        "fresh",
        "jsx",
        "workspace",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@ionaru/fresh-passkeys": "jsr:@ionaru/fresh-passkeys@^1.0.0",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@simplewebauthn/browser": "jsr:@simplewebauthn/browser@^13.3.0",
    "@simplewebauthn/server": "jsr:@simplewebauthn/server@^13.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/http": "jsr:@std/http@^1.1.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.0",
    "@tsparticles/confetti": "npm:@tsparticles/confetti@^4.0.5",
    "@tsparticles/engine": "npm:@tsparticles/engine@^4.0.5",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-beta.23",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-beta.23",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.2",
    "react-icons": "npm:react-icons@^5.6.0",
    "tailwindcss-neumorphism-ui": "npm:tailwindcss-neumorphism-ui@^2.0.0",
    "tailwindcss": "npm:tailwindcss@^4.3.0",
    "vite": "npm:vite@^7.3.2"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
