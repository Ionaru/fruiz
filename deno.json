{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "fix": "deno fmt . && deno lint --fix .",
    "test": "deno test -A tests/",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "db:sync": "dx drizzle-kit push",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@simplewebauthn/browser": "jsr:@simplewebauthn/browser@^13.3.0",
    "@simplewebauthn/server": "jsr:@simplewebauthn/server@^13.3.0",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/http": "jsr:@std/http@^1.0.25",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "drizzle-kit": "npm:drizzle-kit@1.0.0-beta.19",
    "drizzle-orm": "npm:drizzle-orm@1.0.0-beta.19",
    "fresh": "jsr:@fresh/core@^2.2.0",
    "preact": "npm:preact@^10.27.2",
    "tailwindcss-neumorphism-ui": "npm:tailwindcss-neumorphism-ui@^2.0.0",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "vite": "npm:vite@^7.1.3"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
