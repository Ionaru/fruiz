# Copy to .env next to compose.yaml. Docker Compose reads that file automatically
# because compose.yaml lives at the repo root.
#
# Every variable below is a pass-through with a fallback in the app, so a typo is
# invisible: the container still starts, / still returns 200, and the healthcheck
# still goes green. Check the deployed site, not the deploy job.

# WebAuthn Relying Party ID. MUST be the deployed domain. When unset,
# src/lib/passkeyConfig.ts falls back to "localhost" and every passkey
# registration and login fails against the real domain.
FRUIZ_RP_ID=fruiz.example.com

# RP display name shown in the passkey prompt.
FRUIZ_RP_NAME=Musical Quiz

# Marks session cookies Secure. Must be the literal "1" (src/lib/session.ts).
FRUIZ_SECURE_COOKIES=1

# Set to "true" to enable Drizzle query logging.
#FRUIZ_DEBUG=true

# Where the SQLite database and uploaded audio live. Leave unset to use the
# "fruiz_data" named volume declared in compose.yaml. The only other valid value
# is an ABSOLUTE host path; a bare volume name fails compose validation with
# "refers to undefined volume".
#FRUIZ_DATA_VOLUME=/absolute/path/to/data

# The SigNoz collector's Docker network and OTLP endpoint. Check the network
# against `docker network ls` and the endpoint against the collector's own
# compose service name.
FRUIZ_TELEMETRY_NETWORK=signoz_default
FRUIZ_OTLP_ENDPOINT=http://signoz-otel-collector:4318
